# SmartProcure Backend Environment Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Supabase (Optional for local mock mode, required for cloud sync)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Voice & SMS Adapters (Default mock for local evaluation)
VOICE_PROVIDER=mock
SMS_PROVIDER=mock
